                    -- warn only, abort send, do NOT change text
                    ab.TextColor3=Color3.fromRGB(231,76,60)
                    task.delay(3,function() if ab and ab.Parent then ab.TextColor3=Color3.fromRGB(255,255,255) end end)
                    UpdateStatus("⚠ Not enough stock: "..child.Name.." (have "..actual..")",Color3.fromRGB(231,76,60))
                    return {},false
                else
                    payload[child.Name]=math.min(want,199800); has=true
                end
            end
        end
    end
    return payload,has
end

