-- ====================
local AutoClaimBtn    = Instance.new("TextButton")
local isAutoClaiming  = false

local function ToggleAutoClaim(force)
    if force~=nil then if isAutoClaiming==force then return end; isAutoClaiming=force
    else isAutoClaiming=not isAutoClaiming end

    local env = type(getgenv)=="function" and getgenv() or _G
    local key = "__GardenAutoClaimMailbox"

    if isAutoClaiming then
        AutoClaimBtn.Text="🛑 STOP CLAIM"
        TweenService:Create(AutoClaimBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(231,76,60)}):Play()
        UpdateStatus("Auto Claim running...",Color3.fromRGB(46,204,113))
        if type(env[key])=="table" and type(env[key].Shutdown)=="function" then pcall(env[key].Shutdown) end

        local Cfg={Enabled=true,PollInterval=0.2,RetryDelay=2,MaxClaimsPerPass=999}
        local self={Running=true,Busy=false,Wake=true,Inbox=nil,RetryAt={},Connections={}}
        env[key]=self

        function self.Shutdown()
            self.Running=false
            for _,c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
            if env[key]==self then env[key]=nil end
        end

        local function claimAll()
            if self.Busy or not Cfg.Enabled then return end
            self.Busy=true
            local inbox=self.Inbox or (function()
                local ok,r=pcall(function() return Net.Mailbox.OpenInbox:Fire() end)
                return ok and typeof(r)=="table" and (r.Mailbox or r) or nil
            end)()
            self.Inbox=nil; local found=0
            if inbox then
                for mailId in pairs(inbox) do
                    if not self.Running or found>=Cfg.MaxClaimsPerPass then break end
                    if type(mailId)=="string" and (self.RetryAt[mailId] or 0)<=os.clock() then
                        found+=1
                        local md=type(inbox[mailId])=="table" and inbox[mailId] or nil
                        task.spawn(function()
                            local ok,s=pcall(function() return Net.Mailbox.Claim:Fire(mailId) end)
                            if ok and s then
                                self.RetryAt[mailId]=nil
                                pcall(function()
                                    local ci={}
                                    if type(md)=="table" then
                                        local it=md.Items or md.Batch or md.Contents or md.Gifts or {}
                                        if type(it)=="table" then
                                            for _,i2 in ipairs(it) do
                                                if type(i2)=="table" then
                                                    local n=i2.ItemKey or i2.Name or i2.Item or "Item"
                                                    local c=i2.Count or i2.Amount or i2.Quantity or 1
                                                    ci[tostring(n)]=(ci[tostring(n)]or 0)+c
                                                end
                                            end
                                        end
                                        if not next(ci) then
                                            for k,v in pairs(md) do
                                                if type(k)=="string" and type(v)=="number" and k~="MailId" and k~="SenderId" and k~="Timestamp" then ci[k]=v end
                                            end
                                        end
                                    end
                                    AddClaimedLog(next(ci) and ci or nil)
                                end)
                            else self.RetryAt[mailId]=os.clock()+Cfg.RetryDelay end
                        end)
                    end
                end
            end
            self.Busy=false; self.Wake=found>0
        end

        table.insert(self.Connections, Net.Mailbox.Updated.OnClientEvent:Connect(function(u)
            if typeof(u)=="table" and typeof(u.Mailbox)=="table" then self.Inbox=u.Mailbox end
            self.Wake=true
        end))
        task.spawn(function()
            while self.Running do
                if self.Wake then self.Wake=false; claimAll() end
                task.wait(Cfg.PollInterval); self.Wake=Cfg.Enabled
            end
        end)
    else
        AutoClaimBtn.Text="📥 AUTO CLAIM"
        TweenService:Create(AutoClaimBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(243,156,18)}):Play()
        UpdateStatus("Auto Claim stopped.",Color3.fromRGB(150,150,150))
        if type(env[key])=="table" and type(env[key].Shutdown)=="function" then pcall(env[key].Shutdown) end
    end
end
