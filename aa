local function getInv()
    local ok,r = pcall(function() return PS:WaitForLocalReplica(10) end)
    if ok and r and r.Data and type(r.Data.Inventory)=="table" then return r.Data.Inventory end
    return nil
end
local function getCleanInventory()
    local inv=getInv(); if not inv then return {} end
    local list={}
    if type(inv.Pets)=="table" then
        local pc={}
        for _,p in pairs(inv.Pets) do
            if type(p)=="table" and p.Name and not p.Equipped then pc[p.Name]=(pc[p.Name]or 0)+1 end
        end
        for n,c in pairs(pc) do table.insert(list,{Name=n,Count=c,IsPet=true}) end
    end
    for cat in pairs(STACK) do
        if type(inv[cat])=="table" then
            for n,c in pairs(inv[cat]) do
                if type(c)=="number" and c>0 then table.insert(list,{Name=n,Count=c,IsPet=false}) end
            end
        end
    end
    table.sort(list,function(a,b) return a.Name<b.Name end)
    return list
end
local function getInvMap()
    local m={}; for _,it in ipairs(getCleanInventory()) do m[it.Name]=it.Count end; return m
end
local function buildBatch(inv,items)
    local out,max={},20
    for name,amt in pairs(items) do
        if #out>=max then break end
        local want=math.max(1,math.floor(tonumber(amt)or 1))
        if type(inv.Pets)=="table" then
            for key,p in pairs(inv.Pets) do
                if want<=0 or #out>=max then break end
                if type(p)=="table" and p.Id and not p.Equipped and tostring(p.Name)==name then
                    out[#out+1]={Category="Pets",ItemKey=key,Count=1}; want-=1
                end
            end
        end
        if want>0 then
            for cat in pairs(STACK) do
                local t=inv[cat]
                if type(t)=="table" and type(t[name])=="number" and t[name]>0 then
                    local sa=math.min(want,t[name])
                    while sa>0 and #out<max do
                        local ch=math.min(sa,9990)
                        out[#out+1]={Category=cat,ItemKey=name,Count=ch}; sa-=ch
                    end
                    break
                end
            end
        end
    end
    return out
end

local function internalSendMail(targetUser,itemsPayload,noteText)
    if not targetUser or targetUser=="" or not itemsPayload or not next(itemsPayload) then
        return false,"Missing information"
    end
    local inv=getInv(); if not inv then return false,"Inventory not found" end
    local batch=buildBatch(inv,itemsPayload)
    if #batch==0 then return false,"Not enough items/pets" end
    local uid=CachedUID
    if not uid then
        local ok,res=pcall(function() return Net.Mailbox.LookupPlayer:Fire(targetUser) end)
        if not ok or type(res)~="number" or res<=0 then return false,"Server Error or invalid name" end
        uid=res
    end
    local note = (noteText and noteText~="") and noteText or (C.MAIL_NOTE or "Bot Gift")
    local ok,success,msg=pcall(function() return Net.Mailbox.SendBatch:Fire(uid,batch,note) end)
    if success==true or success==nil then
        getgenv().LastGiftTime=os.clock(); return true
    else
        CachedUID=nil; return false,tostring(msg or "Mailbox Error")
    end
end

