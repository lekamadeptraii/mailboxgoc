-- ==========================================
-- GIFT ONCE
-- ==========================================
local isProcessingGift=false
local function FireGift()
    if isProcessingGift then return false end
    local curText=UserInput.Text:gsub("%s+","")
    if not IsVerified or curText=="" or curText~=VerifiedUser then
        UpdateStatus("Verify user first!",Color3.fromRGB(231,76,60)); return false
    end
    local tp=os.clock()-(getgenv().LastGiftTime or 0)
    if tp<GLOBAL_COOLDOWN then
        UpdateStatus("Cooldown: "..math.ceil(GLOBAL_COOLDOWN-tp).."s",Color3.fromRGB(231,76,60)); return false
    end

    local payload,has=GetPayloadFromUI()
    if not has then
        if not next(payload) then
            local any=false
            for _,c in ipairs(ScrollList:GetChildren()) do
                if c:IsA("Frame") then local cb=c:FindFirstChild("Checkbox"); if cb and cb.Text=="✓" then any=true; break end end
            end
            if not any then UpdateStatus("Select an item!",Color3.fromRGB(231,76,60)) end
        end
        return false
    end

    isProcessingGift=true; GiftBtn.Text="SENDING..."
    UpdateStatus("Sending...",Color3.fromRGB(241,196,15))

    local noteText=NoteInput.Text:gsub("%s+$",""):gsub("^%s+","")
    local success,err=internalSendMail(VerifiedUser,payload,noteText)

    if success then
        dailyData.count+=1; saveDailyLimit()
        DailyLimitLabel.Text=string.format("Daily Gifts: %d/50",dailyData.count)
        DailyLimitLabel.TextColor3=dailyData.count>=50 and Color3.fromRGB(231,76,60) or Color3.fromRGB(46,204,113)

        -- history log with avatar
        AddHistoryLog(VerifiedUser,payload,CachedAvatarURL)
        -- webhook
        SendWebhook(VerifiedUser,CachedUID,payload,(noteText~="" and noteText or "Bot Gift"),CachedAvatarURL)
        -- reset amounts to 1 AND uncheck all checkboxes
        ResetAllAmounts()
        for _,c in ipairs(ScrollList:GetChildren()) do
            if c:IsA("Frame") then
                local cb=c:FindFirstChild("Checkbox")
                if cb then cb.Text="" end
            end
        end

        GiftBtn.Text="✓ SENT!"
        TweenService:Create(GiftBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(39,174,96)}):Play()
        UpdateStatus("Gift sent! ("..dailyData.count.."/50)",Color3.fromRGB(46,204,113))
        task.wait(1.5); GiftBtn.Text="GIFT ONCE"
        TweenService:Create(GiftBtn,TweenInfo.new(0.3),{BackgroundColor3=Color3.fromRGB(46,204,113)}):Play()
    else
        -- [NEW] If fail and over limit → log MAX LIMIT, else log generic fail
        if dailyData.count>=50 then
            AddLimitLog(VerifiedUser)
            UpdateStatus("MAX LIMIT DAY CANT GIFT",Color3.fromRGB(231,76,60))
        else
            UpdateStatus("Failed: "..tostring(err or "?"),Color3.fromRGB(231,76,60))
        end
        GiftBtn.Text="✗ FAILED"
        TweenService:Create(GiftBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(231,76,60)}):Play()
        task.wait(2); GiftBtn.Text="GIFT ONCE"
        TweenService:Create(GiftBtn,TweenInfo.new(0.3),{BackgroundColor3=Color3.fromRGB(46,204,113)}):Play()
    end

    isProcessingGift=false; return success
end
GiftBtn.MouseButton1Click:Connect(function() FireGift() end)

-- ==========================================
-- AUTO GIFT
-- ==========================================
local isAutoGifting=false
AutoGiftBtn.MouseButton1Click:Connect(function()
    isAutoGifting=not isAutoGifting
    if isAutoGifting then
        AutoGiftBtn.Text="🛑 STOP AUTO"
        TweenService:Create(AutoGiftBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(231,76,60)}):Play()
        task.spawn(function()
            while isAutoGifting do
                local curText=UserInput.Text:gsub("%s+","")
                if not IsVerified or curText~=VerifiedUser then
                    UpdateStatus("Verify user first!",Color3.fromRGB(231,76,60)); isAutoGifting=false; break
                end
                local payload,has=GetPayloadFromUI()
                if not has then
                    if not next(payload) then
                        UpdateStatus("No items selected!",Color3.fromRGB(231,76,60))
                    end
                    isAutoGifting=false; break
                end
                local tp=os.clock()-(getgenv().LastGiftTime or 0)
                if tp<GLOBAL_COOLDOWN then task.wait(GLOBAL_COOLDOWN-tp+0.1) end
                if not isAutoGifting then break end

                local noteText=NoteInput.Text:gsub("%s+$",""):gsub("^%s+","")
                local success,err=internalSendMail(VerifiedUser,payload,noteText)
                if success then
                    dailyData.count+=1; saveDailyLimit()
                    DailyLimitLabel.Text=string.format("Daily Gifts: %d/50",dailyData.count)
                    DailyLimitLabel.TextColor3=dailyData.count>=50 and Color3.fromRGB(231,76,60) or Color3.fromRGB(46,204,113)
                    AddHistoryLog(VerifiedUser,payload,CachedAvatarURL)
                    SendWebhook(VerifiedUser,CachedUID,payload,(noteText~="" and noteText or "Bot Gift"),CachedAvatarURL)
                    -- keep amounts & checkboxes intact during auto loop
                    UpdateStatus("Auto sent! ("..dailyData.count.."/50)",Color3.fromRGB(46,204,113))
                else
                    if dailyData.count>=50 then
                        AddLimitLog(VerifiedUser)
                        UpdateStatus("MAX LIMIT DAY CANT GIFT",Color3.fromRGB(231,76,60))
                    else
                        UpdateStatus("Auto fail: "..tostring(err or "?"),Color3.fromRGB(231,76,60))
                    end
                    task.wait(3)
                end
                task.wait(0.5)
            end
            isAutoGifting=false; AutoGiftBtn.Text="⚡ AUTO GIFT"
            TweenService:Create(AutoGiftBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(155,89,182)}):Play()
            -- reset amounts + uncheck all when auto gift loop ends
            ResetAllAmounts()
            for _,c in ipairs(ScrollList:GetChildren()) do
                if c:IsA("Frame") then
                    local cb=c:FindFirstChild("Checkbox")
                    if cb then cb.Text="" end
                end
            end
        end)
    else
        AutoGiftBtn.Text="⚡ AUTO GIFT"
        TweenService:Create(AutoGiftBtn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(155,89,182)}):Play()
        UpdateStatus("Auto Gift stopped.",Color3.fromRGB(150,150,150))
        -- reset amounts + uncheck all when user manually stops
        task.defer(function()
            ResetAllAmounts()
            for _,c in ipairs(ScrollList:GetChildren()) do
                if c:IsA("Frame") then
                    local cb=c:FindFirstChild("Checkbox")
                    if cb then cb.Text="" end
                end
            end
        end)
    end
end)
