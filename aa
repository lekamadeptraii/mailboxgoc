-- AUTH
-- ==========================================
local function PerformAuthentication(key)
    local kd=KEYS_DATABASE[key]
    if kd and kd.IsAdmin==true then
        UpdateStatus("Admin Bypass...",Color3.fromRGB(46,204,113)); task.wait(0.5)
        KeyFrame.Visible=false; GiftFrame.Visible=true; RefreshInventoryUI(); return true
    end
    if not RealHWID or RealHWID=="" then UpdateStatus("Hardware ID error!",Color3.fromRGB(231,76,60)); return false end
    if kd then
        if kd.CheckExternalHWID then
            UpdateStatus("Connecting...",Color3.fromRGB(241,196,15))
            local link=kd.ExternalLink..(string.find(kd.ExternalLink,"?") and "&t=" or "?t=")..tostring(os.time())
            local s,r=pcall(function() return game:HttpGet(link) end)
            if s and r and r~="" then
                local s2,l=pcall(function() return loadstring(r)() end)
                if s2 and type(l)=="table" and l[RealHWID] then
                    UpdateStatus("Verified!",Color3.fromRGB(46,204,113)); task.wait(0.5)
                    KeyFrame.Visible=false; GiftFrame.Visible=true; RefreshInventoryUI(); return true
                else LocalPlayer:Kick("Invalid HWID. Contact Admin."); return false end
            else UpdateStatus("Network fetch failed!",Color3.fromRGB(231,76,60)); return false end
        end
    else UpdateStatus("Invalid Key!",Color3.fromRGB(231,76,60)); return false end
end

CheckKeyBtn.MouseButton1Click:Connect(function() PerformAuthentication(KeyInput.Text) end)
if getgenv().script_key and getgenv().script_key~="" then
    KeyInput.Text=getgenv().script_key
    task.spawn(function() PerformAuthentication(getgenv().script_key) end)
end

